# Скопируйте в .env рядом с pulsenet и поправьте. Переменные окружения имеют приоритет над файлом.
# Пути без пробелов: LLAMACPP_EXTRA_ARGS режется по пробелам.

# --- LLM: llamacpp (llama-server) или lmstudio (LM Studio) ---
LLM_BACKEND=llamacpp
MODELS_DIR=E:\models
LLAMACPP_SERVER_BIN=C:\llama.cpp\llama-server.exe
LLAMACPP_PORT=8090
LLAMACPP_DEFAULT_MODEL=lmstudio-community/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q8_0.gguf
LLAMACPP_AUTOSTART=1
LLAMACPP_CUDA_DEVICE_ORDER=PCI_BUS_ID
# LoRA-адаптер «Сна» (пока пусто): LLAMACPP_EXTRA_ARGS=--lora-scaled E:\models\lora\triplex-sleep.gguf 0.5
# LLAMACPP_EXTRA_ARGS=

# LM Studio (LLM_BACKEND=lmstudio)
# LMSTUDIO_URL=http://localhost:1234/v1
# Стабильный default, если пользователь не выбрал модель в интерфейсе.
# Приложение НЕ подхватывает «первую загруженную в LM Studio» модель:
# смена модели идёт только от выбора пользователя или от этой настройки.
# LMSTUDIO_MODEL=имя-модели

# --- сервер ---
# 127.0.0.1 — без nginx; 0.0.0.0 — если nginx в Docker (закройте порт в брандмауэре для внешних адресов)
PULSENET_HOST=127.0.0.1
PULSENET_PORT=8000

# --- веб-вход (email + пароль + код из письма) ---
# Вход включён по умолчанию. AUTH_DISABLED=1 — локальный режим без входа (только для себя).
AUTH_DISABLED=0
LOCAL_USER_ID=local_user
# Обязательно задайте постоянный ключ (не короче 32 символов), иначе сессии сбрасываются
# при каждом рестарте. Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
SESSION_LIFETIME=1209600
AUTH_DB_PATH=data/auth.db
# 1 — писать код в лог вместо письма (только для разработки!)
AUTH_DEV_MODE=0
APP_NAME=ТРИПЛЕКСИЯ
# Secure-флаг cookie (включите за HTTPS): SECURE_COOKIES=1 или FLASK_ENV=production
# SECURE_COOKIES=1

# Почта для кодов: реквизиты и «no-reply» отправитель — ТОЛЬКО из env/.env.
# MAIL_PROVIDER: smtp | resend | brevo | unisender_go
MAIL_PROVIDER=smtp
# SMTP_FROM — адрес отправителя. Допустимо также EMAIL_FROM / NO_REPLY / NO_REPLY_EMAIL.
SMTP_FROM=noreply@example.com
# EMAIL_FROM=noreply@example.com
# NO_REPLY=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
# Для HTTPS-провайдеров (если SMTP-порты закрыты):
# RESEND_API_KEY=
# BREVO_API_KEY=
# UNISENDER_GO_API_KEY=
# UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1

# --- MCP (внешние ИИ). Без токена /mcp отключён ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSENET_MCP_TOKEN=
# Адрес MCP-сервера (значения по умолчанию); CLI и сервер запускаются из корня репозитория.
# PULSENET_UNIFIED_HOST=127.0.0.1
# PULSENET_UNIFIED_PORT=8010
# Host и Origin, которые принимает MCP-сервер (через запятую). Для домена через nginx добавьте их.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# Владелец памяти и кто меняет общее ядро
MCP_OWNER_ID=owner
MCP_ADMIN_USERS=owner
# Чтение кода: кто может (пусто — никому) и корни вида имя=путь (несколько через ;)
CODE_ACCESS_USERS=
CODE_ROOTS=
# Необязательный путь к проекту для глубокого поиска
# BLOCKCOIN_PATH=

# Токены пользователей выпускаются в Настройках чата (Обновить ключ MCP) или CLI
# (команды выполнять из корня репозитория):
#   python -m pulsenet.unified_mcp issue-token u1
#   python -m pulsenet.unified_mcp rotate u1
#   python -m pulsenet.unified_mcp list-tokens
# Токен владельца выше (PULSENET_MCP_TOKEN) через UI не меняется — только в .env + рестарт.
# PULSENET_DATA_DIR — каталог unified MCP с tokens.sqlite (по умолчанию data_unified рядом с data/).
# MCP_TOKEN_SECRET — секрет шифрования токена для показа текущего ключа в Настройках.
# Если не задан, создаётся файл <PULSENET_DATA_DIR>/mcp_token.key (права 0600).
# ВАЖНО: не теряйте секрет/файл ключа — без него уже выданные токены нельзя будет показать.
# PULSENET_DATA_DIR=data_unified
# MCP_TOKEN_SECRET=
# MCP_TOKEN_KEY_PATH=data_unified/mcp_token.key

# --- память ТРИПЛЕКСИЯ ---
# mcp   — память у MCP-сервера pulsenet-unified: общая для всех токенов/пользователей сервера (рекомендуется).
#         Нужны PULSENET_CHAT_MCP_TOKEN (python -m pulsenet.unified_mcp issue-token chat) и запущенный MCP.
# local — журнал внутри чата (data/triplex), как раньше.
PULSENET_MEMORY=mcp
PULSENET_MCP_URL=http://127.0.0.1:8010/mcp
PULSENET_CHAT_MCP_TOKEN=
# Инструменты MCP в чате (image_generate, triplex_*, web_* и др.). 0 — отключить.
# Без токена чат видит только локальные инструменты и не сможет рисовать картинки.
PULSENET_CHAT_TOOLS=1
# MCP-сервер: общая память для ВСЕХ токенов (shared) или изоляция по пользователям (per_user)
MCP_MEMORY_SCOPE=shared
# Извлечение фактов на MCP-сервере: адрес OpenAI-совместимого сервера (тот же llama-server)
# TRIPLEX_LLM_URL=http://127.0.0.1:8090/v1
# TRIPLEX_LLM_MODEL=local
# cpu — эмбеддер и модель экстракции грузятся через lms load --gpu off (VRAM остаётся чату).
# Модель, явно переданная чатом, эту настройку не использует.
TRIPLEX_LOCAL_DEVICE=cpu
TRIPLEX_LLM_CONTEXT=8192
TRIPLEX_MEMORY=1

# Ваше имя: «я» в ваших репликах запишется как это имя
TRIPLEX_USER_NAME=
# Порог релевантности (0.35 — для офлайн-эмбеддера; с bge-m3 подберите по данным)
TRIPLEX_MIN_COS=0.35
# --- эмбеддер: достаточно одного из вариантов. Модель и размерность определяются сами ---
# Вариант 1 (рекомендуется): модель эмбеддингов загружена в LM Studio (любая: bge-m3, nomic, e5).
# Загрузите её в LM Studio и оставьте загруженной; если она там одна — имя можно не указывать.
# GGUF, лежащий прямо в папке моделей, LM Studio может не увидеть — импортируйте его:
#   lms import -L "E:\models\model.gguf" -y
TRIPLEX_EMBED_URL=http://localhost:1234/v1
#
# Вариант 2: отдельный процесс llama-server из GGUF (грузится один раз при старте приложения).
# Раскомментируйте путь и поставьте, например, bge-m3-f16.gguf или nomic-embed-text-v1.5.Q4_K_M.gguf:
# TRIPLEX_EMBED_MODEL_PATH=E:\models\embed\bge-m3-f16.gguf
# TRIPLEX_EMBED_PORT=8091
# TRIPLEX_EMBED_POOLING=cls
#   (для nomic: TRIPLEX_EMBED_POOLING=mean)
#
# Если в LM Studio несколько моделей эмбеддингов, укажите нужную явно:
# TRIPLEX_EMBED_MODEL=text-embedding-bge-m3
# TRIPLEX_EMBED_DIM=1024
#
# Префиксы задач подбираются по имени модели (nomic, e5). Переопределить:
# TRIPLEX_EMBED_DOC_PREFIX=
# TRIPLEX_EMBED_QUERY_PREFIX=
# Экстракция идёт через бэкенд чата; переопределить адрес:
# TRIPLEX_LLM_URL=http://127.0.0.1:8080/v1
# TRIPLEX_LLM_MODEL=local

# --- поиск: SearXNG в Docker (см. searxng/) ---
# run_server.bat поднимает контейнер; если Docker недоступен, поиск идёт через DuckDuckGo.
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_BACKENDS_ORDER=searxng,ddg
SEARCH_TIME_BUDGET=15
# Секунд кэша web_fetch; 0 отключает кэш
WEB_CACHE_TTL=600

# --- генерация изображений: MCP-инструмент image_generate ---
# Бэкенды перебираются по очереди, первый успешный побеждает.
# easydiffusion — локальный EasyDiffusion API (/render + /image/stream); pollinations — запасной без ключа.
IMAGE_BACKENDS_ORDER=easydiffusion,pollinations
# Порт Easy Diffusion берётся из его config.yaml (по умолчанию 9000); 7860 — только если вы его поменяли.
EASYDIFFUSION_URL=http://127.0.0.1:9000
EASYDIFFUSION_MODEL=DreamShaper8_pruned.safetensors
EASYDIFFUSION_VAE=
EASYDIFFUSION_STEPS=30
EASYDIFFUSION_WIDTH=512
EASYDIFFUSION_HEIGHT=768
EASYDIFFUSION_CFG=7.0
EASYDIFFUSION_SAMPLER=Euler
EASYDIFFUSION_NEGATIVE_PROMPT=(worst quality, low quality:1.4), blurry, lowres, watermark, text, bad anatomy, bad hands, extra fingers
EASYDIFFUSION_LORA=
EASYDIFFUSION_LORA_USE=0
EASYDIFFUSION_LORA_WEIGHT=0.8
EASYDIFFUSION_TIMEOUT=180
# По умолчанию НЕ привязано к PULSENET_DATA_DIR: при смене каталога данных задайте явно.
IMAGE_OUTPUT_DIR=data_unified/images
IMAGE_INLINE_MAX_BYTES=1500000
IMAGE_MAX_PROMPT_CHARS=500
IMAGE_POLLINATIONS_MODEL=flux
# Автозапуск Easy Diffusion из run_server.bat (PID-файл — data_unified/easydiffusion.pid)
EASYDIFFUSION_DIR=E:\Easy-Diffusion
EASYDIFFUSION_PORT=9000
EASYDIFFUSION_AUTOSTART=1
EASYDIFFUSION_START_TIMEOUT=180

# --- агентный цикл чата ---
# 0 = без лимита: агент работает, пока сам не даст итоговый текст; трасса в UI не обрезается.
# Ненулевые значения — жёсткие лимиты (совместимость со старыми сценариями и тестами).
# AGENT_HARD_CAP оставлен для совместимости и в цикле не используется.
AGENT_MAX_ROUNDS=0
AGENT_HARD_CAP=8
AGENT_MAX_CALLS=0
# Сколько раз просить модель договорить после finish_reason=length. 0 = без лимита.
AGENT_MAX_CONTINUATIONS=0
AGENT_REFLECTION_BUDGET=2
# Лимит генерации на один шаг агента. 1024 не хватало на JSON <tool_call> —
# модель обрезалась посреди вызова, и цикл считал, что инструментов нет.
AGENT_MAX_TOKENS=4096
# Потолок системного промпта и всего запроса (лишняя история выбрасывается,
# персона и протокол вызовов сохраняются). Видно в карточках шагов в UI.
AGENT_SYSTEM_MAX_CHARS=6000
AGENT_CONTEXT_MAX_CHARS=20000
# Сколько символов результата инструмента уходит в контекст модели.
# JSON усекается структурно: остаётся валидный JSON, а не битый хвост.
TOOL_RESULT_CONTEXT_CHARS=3000
# 0 — отправлять все доступные схемы; N — только первые N.
TOOL_NATIVE_MAX=0
# 1 — передавать схемы через OpenAI tools (при HTTP 400/404/422 без переполнения контекста
# автоматически откат на <tool_call>).
# 0 — только текстовый протокол <tool_call>.
TOOL_NATIVE=1
# Таймаут генерации изображения через MCP, сек
MCP_TOOL_TIMEOUT_IMAGE=300

# --- стабильность и индексация (v4) ---
# Индексация пакетами: сообщения копятся, пока пользователь пишет, и пишутся, когда модель свободна.
# batch — по умолчанию; off — автоматической индексации нет (/remember и memory_remember работают).
INDEX_MODE=batch
# Короче этого (символов) — не индексируем; приветствия и служебные реплики отсекаются всегда.
INDEX_MIN_CHARS=15
# Тишина (сек), после которой пакет уходит в запись. Сообщения одного чата объединяются.
INDEX_DEBOUNCE_SECONDS=8
# Максимум сообщений в одном пакете
INDEX_BATCH_MAX=8
# Сколько секунд не обращаться к серверу памяти после его сбоя (ход не ждёт его каждый раз)
MCP_COOLDOWN_SECONDS=45
# Экстракция фактов через LLM. 0 — выключить, если локальная модель медленная.
TRIPLEX_EXTRACT=1

# --- параллельные вызовы и субагенты ---
# Сколько инструментов принимаем за один шаг модели (порядок вызовов сохраняется).
AGENT_CALLS_PER_STEP=8
# Сколько независимых вызовов выполняем одновременно (запись в навыки/заметки/план — всегда по очереди).
AGENT_PARALLEL=8
# 0 = субагент работает, пока не вернёт текст.
SUBAGENT_MAX_ROUNDS=0
# LLM-запросы субагентов идут в отдельных потоках (1 — строго по очереди).
AGENT_LLM_PARALLEL=2

# --- рабочее пространство агента (навыки, заметки, правила) ---
# Каталог по умолчанию — data_unified рядом с data/ (тот же, что у unified MCP).
# AGENT_WORKSPACE_DIR=data_unified
# 1 — агент может создавать и править навыки (skills/<name>/SKILL.md); 0 — только читать.
AGENT_SKILLS_WRITE=1
# 1 — подключать и корневой AGENTS.md, и data_unified/AGENTS.md: чат работает по тем же
# правилам памяти, что и внешние агенты. 0 — только data_unified/AGENTS.md.
AGENT_PROJECT_RULES=1

# --- озвучка (подробно: docs/TTS.md) ---
# По умолчанию Silero: лёгкая модель 38 МБ, только русский, torch CPU уже установлен.
TTS_ENGINE=silero
TTS_ENABLED=0
SILERO_ENABLED=1
# Голоса меню: aidar, baya, kseniya, xenia, eugene
SILERO_SPEAKER=xenia
SILERO_DEVICE=cpu
# Пусто = data_unified/tts/v4_ru.pt; SILERO_AUTODOWNLOAD=1 скачает модель при первом запросе
SILERO_MODEL_PATH=
SILERO_AUTODOWNLOAD=0
# Ещё легче — Piper (onnxruntime, без torch), но нужно скачать файлы голосов .onnx:
# TTS_ENGINE=piper
# PIPER_VOICES=ru-irina=C:\piper-voices\ru_RU-irina-medium.onnx;en-lessac=C:\piper-voices\en_US-lessac-medium.onnx
# Тяжёлый вариант на 17 языков — XTTS-v2 (веса ~2 ГБ, лицензия CPML):
# TTS_ENGINE=xtts
# XTTS_ACCEPT_LICENSE=1
# XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# XTTS_LANGUAGE=ru
# XTTS_DEVICE=cpu
# XTTS_SPEAKER=Claribel Dervla
# XTTS_SPEAKER_WAV=
